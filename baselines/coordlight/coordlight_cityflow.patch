+    def calculate_advanced_metrics(self):
+        global_veh_stats = {}
+        total_overlimit_events = 0  # number of waits longer than 90 s
+        
+        for tls in self.env.tls_dict.values():
+            # add up the 90 s events counted at each intersection
+            total_overlimit_events += len(tls.delay_events_90s)
+            
+            for veh_id, cumulative_wait in tls.dic_vehicle_cumulative_wait.items():
+                if veh_id not in global_veh_stats:
+                    global_veh_stats[veh_id] = {'cumulative_wait': 0.0, 'max_wait': 0.0}
+                
+                # total waiting time of this vehicle over the whole network
+                global_veh_stats[veh_id]['cumulative_wait'] += cumulative_wait
+                
+                # longest single wait of this vehicle over its whole trip
+                max_wait = tls.dic_vehicle_max_wait.get(veh_id, 0.0)
+                if max_wait > global_veh_stats[veh_id]['max_wait']:
+                    global_veh_stats[veh_id]['max_wait'] = max_wait
+
+        # all_awt_times equals vehicle_total_wait_time of D2-MARL
+        all_awt_times = [v['cumulative_wait'] for v in global_veh_stats.values()]
+        all_mwt_times = [v['max_wait'] for v in global_veh_stats.values()]
+
+        awt = np.mean(all_awt_times) if all_awt_times else 0.0
+        max_wait = np.max(all_mwt_times) if all_mwt_times else 0.0
+
+        if len(self.all_step_queues) > 0:
+            lane_avg_queues = np.mean(self.all_step_queues, axis=0)
+            aql = np.mean(lane_avg_queues)
+        else:
+            aql = 0.0
+
+        # ==== Gini coefficient with the same formula as D2-MARL ====
+        if len(all_awt_times) > 0:
+            wait_array = np.array(all_awt_times, dtype=np.float64)
+            wait_array = np.sort(wait_array)
+            n = len(wait_array)
+            index = np.arange(1, n + 1)
+            # same formula as utils/model_test.py of D2-MARL
+            gini_index = ((2 * index - n - 1) * wait_array).sum() / (n * wait_array.sum() + 1e-8)
